namespace Post
{
	# Streak pattern (Kawase 2003 streak filter). Directions are spread evenly
	# over 360 deg, each a one-sided blur, so StarN gives N spikes.
	enum FlareStreaks
	{
		None;
		Anamorphic;
		Star4;
		Star6;
		Star8;
	}

	# Image-based lens flare, built inside BloomBuild/BloomBuildPost from the
	# thresholded bloom chain and added by BloomComposite (bloom.prism) -- so
	# every bright source flares, and it follows Bloom's threshold.

	# Ghosts + halo (Chapman-style): the thresholded bloom level mirrored
	# through the screen center at several scales, plus a chromatic ring
	# sampled toward the center.
	[Bind = DefaultLayout::Instance0]
	struct LensFlareGhosts
	{
		Texture2D<float4> source;
		RWTexture2D<float4> target;
		float ghost_intensity;
		float halo_intensity;
		# Halo ring radius, in screen-height units.
		float halo_radius;
		# Per-channel scale spread (chromatic fringing).
		float chromatic;
		# width / height of the output.
		float aspect;
	}

	# One Kawase iteration: tapered taps along direction at `step` texel
	# spacing, reading the previous iteration, so each level reaches 4x
	# further. Every level is also summed into accum (like Bloom's Sum mode):
	# equal energy over 4x the length per level gives a bright core and a tail
	# that runs to the screen edge.
	[Bind = DefaultLayout::Instance0]
	struct LensFlareStreak
	{
		Texture2D<float4> source;
		RWTexture2D<float4> target;
		RWTexture2D<float4> accum;
		# Unit direction, in target texels.
		float2 direction;
		float2 texel;
		float step;
		# Weight of this level in accum (Streak falloff ^ level).
		float accum_weight;
		# Non-zero: accum += result; zero: overwrite (first write of the frame).
		uint accumulate;
	}

	ComputePSO LensFlareGhosts
	{
		root = DefaultLayout;

		[EntryPoint = CS_Ghosts]
		compute = "postprocess/lens_flare.hlsl";
	}

	ComputePSO LensFlareStreak
	{
		root = DefaultLayout;

		[EntryPoint = CS_Streak]
		compute = "postprocess/lens_flare.hlsl";
	}
}
