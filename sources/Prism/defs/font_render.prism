namespace UI
{
	namespace Text
	{

		[Bind = DefaultLayout::Instance0]
		struct FontRendering
		{
			Texture2D<float> tex0;
			StructuredBuffer<float4> positions;
		}

		[Bind = DefaultLayout::Instance1]
		struct FontRenderingConstants
		{
			float4x4 TransformMatrix;
			float4 ClipRect;
		}

		struct Glyph
		{
			float2 pos;
			uint index;
			float4 color;
		}

		[Bind = DefaultLayout::Instance2]
		struct FontRenderingGlyphs
		{
			StructuredBuffer<Glyph> data;
		}

		# One Skribidi atlas quad; pos is NDC (x0, y0, x1, y1), uv is (u0, v0, u1, v1).
		struct GlyphQuad
		{
			float4 pos;
			float4 uv;
			float4 color;
			# Repeating patterns (wavy underlines): the atlas rect of one tile;
			# uv then counts tiles and wraps inside it.
			float4 tile;
			uint atlas;
			# Non-zero: RGBA premultiplied color glyph (emoji); zero: R8 coverage.
			uint is_color;
			uint is_pattern;
		}

		[Bind = DefaultLayout::Instance0]
		struct GlyphRender
		{
			StructuredBuffer<GlyphQuad> quads;

			[Auto = Texture_Null]
			Texture2D<float4> textures[];
		}

		GraphicsPSO GlyphRender
		{
			root = DefaultLayout;

			[EntryPoint = VS]
			vertex = "gui/glyph.hlsl";

			[EntryPoint = PS]
			pixel = "gui/glyph.hlsl";

			rtv = { R16G16B16A16_FLOAT };
			blend = { AlphaBlend };
			cull = None;
		}

		GraphicsPSO FontRender
		{
			root = DefaultLayout;

			[EntryPoint = VS]
			vertex = "font/vs_simple.hlsl";

			[EntryPoint = PS]
			pixel = "font/ps_simple.hlsl";

			[EntryPoint = GS]
			geometry = "font/gs_simple.hlsl";

			topology = POINT;

			[type = Format]
			[PS]
			define Format = { ALL_RT_BLENDING_FORMATS };

			rtv = { Format };

			enable_depth = false;
			cull = None;
			#	blend = { AlphaBlend };
		}
	}
}
