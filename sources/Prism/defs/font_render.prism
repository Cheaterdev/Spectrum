namespace UI
{
	namespace Text
	{
		# One Skribidi atlas quad; pos is NDC (x0, y0, x1, y1), uv is (u0, v0, u1, v1).
		struct GlyphQuad
		{
			float4 pos;
			float4 uv;
			float4 color;
			# Repeating patterns (wavy underlines): the atlas rect of one tile;
			# uv then counts tiles and wraps inside it.
			float4 tile;
			uint atlas;
			# Non-zero: RGBA premultiplied color glyph (emoji); zero: R8 coverage.
			uint is_color;
			uint is_pattern;
		}

		[Bind = DefaultLayout::Instance0]
		struct GlyphRender
		{
			StructuredBuffer<GlyphQuad> quads;

			[Auto = Texture_Null]
			Texture2D<float4> textures[];

			# Non-zero: write the sRGB-encoded color as is (off-screen targets such
			# as asset previews); zero: through ui_output() onto the scRGB swapchain.
			uint raw_output;

			# A drop shadow drawn in the same pass: the glyph's coverage again, shifted by
			# shadow_offset (NDC) and tinted shadow_color (straight alpha), under the glyph.
			# The quad grows to hold it. Alpha 0: none.
			float4 shadow_color;
			float2 shadow_offset;
			# The shadow's softness: a five-tap blur this far (NDC, per axis) out; 0 = crisp.
			float2 shadow_blur;
		}

		GraphicsPSO GlyphRender
		{
			root = DefaultLayout;

			[EntryPoint = VS]
			vertex = "gui/glyph.hlsl";

			[EntryPoint = PS]
			pixel = "gui/glyph.hlsl";

			# The UI draws into R16G16B16A16_FLOAT; previews and tests use other targets.
			[type = Format]
			[PS]
			define Format = { ALL_RT_BLENDING_FORMATS };

			rtv = { Format };
			blend = { AlphaBlend };
			cull = None;
		}
	}
}
