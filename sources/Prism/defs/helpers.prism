namespace Frame
{
	[RenderTarget]
	struct SingleColor
	{
		RenderTarget<float4> color;
	}


	[RenderTarget]
	struct NoOutput
	{

	}

	[RenderTarget]
	struct DepthOnly
	{
		DepthStencil<float> depth;
	}

	[RenderTarget]
	struct SingleColorDepth
	{
		RenderTarget<float4> color;
		DepthStencil<float> depth;
	}


	[Static]
	# Creates ResultTexture and clears it. The texture is transient (its memory is reused), so without the clear a
	# pixel no lighting pass writes keeps whatever the memory held -- last frame's image, blended into this one.
	# [RenderCondition = `true`] is what makes the generator emit setup() (a pass with no condition has to write its own).
	[RenderCondition = `true`]
	PassNode ResultCreation
	{
		# [ClearValue] is the optimized clear value baked into the texture when it is created (RenderTarget: RGBA,
		# DepthStencil: x = depth, y = stencil). Keep it equal to what render() clears with, or D3D12 takes the slow
		# clear path and warns. A texture that is neither gets none.
		[Always = RenderTarget] [Size = ViewportContext::frame_size] [Format = R16G16B16A16_FLOAT] [ClearValue = `vec4(0, 0, 0, 0)`] Texture ResultTexture;
	}
}
