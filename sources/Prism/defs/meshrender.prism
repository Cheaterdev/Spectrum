namespace Meshes
{
	[nobind]
	[serialize]
	struct mesh_vertex_input
	{
	    float3 pos;
	    float3 normal;
	    float2 tc;
	    float4 tangent;
	}


	struct AABB
	{
	    float4 min;
	    float4 max;
	}

	struct node_data
	{
	    float4x4 node_global_matrix;
		float4x4 node_global_matrix_prev;
	    float4x4 node_inverse_matrix;
	    AABB aabb;
	}

	[Bind = DefaultLayout::Instance2]
	struct MeshInstanceInfo
	{
		StructuredBuffer<mesh_vertex_input> vertexes;
		StructuredBuffer<uint> indices;
		StructuredBuffer<Meshlet> meshlets;

		StructuredBuffer<MeshletCullData> meshletCullData;
		StructuredBuffer<MeshletGroup> meshletGroups;

		StructuredBuffer<uint> unique_indices;
		StructuredBuffer<uint> primitive_indices;

	}


	[Bind = DefaultLayout::Instance1]
	struct MeshInfo
	{
	    uint vertex_offset_local;
		uint meshlet_offset_local;

	    uint node_offset;
		# Original full-detail clusters, stored first. Passes without cluster LOD
		# selection draw only these.
		uint meshlet_count;
		# Every cluster of the LOD DAG (>= meshlet_count), for LOD-selecting passes.
		uint lod_meshlet_count;
		# This part's MeshletGroup ranges in MeshInstanceInfo::meshletGroups
		# (group indices in nodes are relative to lod_group_offset, cluster
		# indices in groups to meshlet_offset_local). One ClusterLod AS group per node.
		uint lod_group_offset;
		uint lod_node_offset;
		uint lod_node_count;

		# Per mesh part, unique for the instance's lifetime (0 = none), written
		# into GBuffer_ObjectID for editor picking/selection outline. Assigned in
		# MeshAssetInstance::update_nodes().
		uint object_id;

		# This part's first entry in universal_meshlet_mask_manager, one per
		# cluster of the whole DAG (MeshletCaptureWrite).
		uint meshlet_mask_offset;
	}

	# Debug view meshlet capture: the GBuffer AS (CaptureMeshlets permutation)
	# records each cluster it tests as (frame << 4) | status at
	# meshlet_mask_offset + cluster: 0 frustum, 1 backface cone, 2 Hi-Z
	# occluded, 3 drawn, 4 not in the LOD cut. The LOD hierarchy never visits
	# most clusters; their stale frame reads as "not in the LOD cut", so the
	# buffer needs no per-frame clear. Only meaningful for a part the main view
	# drew on the captured frame (CullCaptureWrite stamps).
	[Bind = DefaultLayout::Instance5]
	struct MeshletCaptureWrite
	{
		RWStructuredBuffer<uint> masks;
		uint frame;
	}


	struct RaytraceInstanceInfo
	{
		StructuredBuffer<mesh_vertex_input> vertexes;
		StructuredBuffer<uint> indices;
		# Phase 5.19: same value as MeshCommandData.material_id (both come from
		# universal_material::get_material_id()) -- lets a hit shader/inline
		# RayQuery reach GetSceneData().GetMaterials()[material_id] from
		# InstanceID() alone, the same way the main render path already reaches
		# it from a mesh index. Needed because per-material hit-group shader-
		# table binding (see raytracing.prism's ColorShadowPass) isn't reachable
		# from inline ray tracing at all -- this is the one path that is.
		uint material_id;
		# SceneData.nodes index. The BLAS bakes the node's mesh_matrix into its
		# geometry, so ObjectToWorld3x4() (the instance transform) alone does not
		# take vertex normals to world space; node_global_matrix does.
		uint node_offset;
	}

	struct Meshlet
	{
	    uint vertexCount;
	    uint vertexOffset;
	    uint primitiveCount;
	    uint primitiveOffset;
	}

	[serialize]
	struct MeshletCullData
	{
	    float4 BoundingSphere;
	    # meshopt's snorm8 cone axis (xyz) and cutoff (w), the cutoff already
	    # padded for axis quantization; w = 127 means no backface test.
	    uint   NormalCone;

	    # Cluster LOD (meshopt clusterlod): a cluster is drawn when its group's
	    # LodError (MeshletGroup) projects over the threshold -- the coarser
	    # version is not good enough -- and RefinedError, from RefinedSphere,
	    # projects at or under it -- this one is. RefinedError is negative for
	    # original geometry. Mesh-space.
	    float  RefinedError;
	    uint   LodLevel;
	    float4 RefinedSphere;
	}

	# Cluster LOD hierarchy, both levels in one buffer (MeshInstanceInfo):
	# - group: a clusterlod group's clusters (FirstCluster/ClusterCount, <= 16,
	#   bigger groups are split), LodSphere/LodError its own simplification
	#   error (FLT_MAX where nothing coarser exists), RefinedSphere/RefinedError
	#   enclose its clusters' refined bounds, min error (negative if any cluster
	#   is original geometry).
	# - node: 32 consecutive groups (FirstCluster/ClusterCount = group range),
	#   LodSphere/LodError = enclosing sphere and max, Refined* = enclosing and min.
	# Enclosing spheres make both levels conservative: a node or group is only
	# skipped when every group or cluster under it would fail its own test.
	[serialize]
	struct MeshletGroup
	{
		float4 LodSphere;
		float4 RefinedSphere;
		float  LodError;
		float  RefinedError;
		uint   FirstCluster;
		uint   ClusterCount;
	}



	[IndirectCommand]
	[shader_only]
	struct DrawIndexedArguments
	{
		uint data[5];
	}

	[IndirectCommand]
	[shader_only]
	struct DispatchMeshArguments
	{
		uint3 counts;
	}

	[IndirectCommand]
	[shader_only]
	struct DispatchArguments
	{
		uint3 counts;
	}

	[shader_only]
	struct GPUAddress
	{
		uint2 data;
	}


	struct MeshInstance
	{
		uint vertex_offset;
		uint index_offset;
	}

	[IndirectCommand]
	struct CommandData
	{
		MeshInfo* mesh_cb;
		MeshInstanceInfo* meshinstance_cb;
		MaterialInfo* material_cb;
		DispatchMeshArguments draw_commands;
	}

	struct MeshCommandData
	{
		uint material_id;
		uint node_offset;
		MeshInfo* mesh_cb;
		MeshInstanceInfo* meshinstance_cb;
		# Original clusters, 32 per AS group: every pass without ClusterLod.
		DispatchMeshArguments draw_commands;
		# One AS group per LOD hierarchy node: GatherPipeline's ClusterLod.
		DispatchMeshArguments lod_draw_commands;
		uint meshlet_count;
	}

	enum TransparencyMode
	{
		# Fully opaque: no clip(), BLAS geometry stays opaque (no any-hit).
		Opaque;
		# Alpha-cutout (foliage, fences): drawn into the GBuffer with clip() on
		# opacity, any-hit alpha test in RT, VSM's material depth PSO.
		Masked;
		# Glass/water: kept out of GBuffer/VSM/voxelization entirely and drawn by
		# TranslucentRTX (raytracing.prism) on top of the lit scene instead.
		Translucent;
	}

	# TLAS instance masks. Translucent instances are separated so TranslucentRTX
	# can trace them alone, and so opaque-only queries (VSM's blocker verify ray,
	# TranslucentRTX's "what's behind the glass" rays) skip them.
	enum RTInstanceMask
	{
		Opaque = 1;
		Translucent = 2;
	}

	struct MaterialCommandData
	{
		uint material_cb;
		uint pipeline_id;
		# Set from universal_material's transparency mode at the same site
		# material_cb/pipeline_id are populated. Lets GPU-side passes (VSM's
		# vsm_gather_dispatch.hlsl, VSM_ShadowResolve's inline RayQuery,
		# TranslucentRTX) route a mesh without decoding the material graph.
		TransparencyMode transparency_mode;
		# RAW bindless descriptor-heap index (ResourceDescriptorHeap[this] is a
		# plain Texture2D, from anywhere) of whichever texture directly drives
		# this material's opacity graph output, or ~0u ("unknown") if there
		# isn't a simple single-texture answer (universal_material.cpp's
		# find_opacity_texture() only recognizes the common direct-wiring case).
		# Only set for Masked materials.
		# Deliberately NOT an index into MaterialInfo.textures[] -- that array
		# sits after MaterialInfo's own [dynamic] MaterialCB data, whose byte
		# size varies per material, so it's only readable from the material's
		# own compiled shader. Lets VSM's inline RTX blocker-search RayQuery
		# sample the real opacity texture per candidate hit and skip committing
		# it below threshold, without needing that compiled shader -- inline ray
		# tracing has no local root signature to reach it with (see
		# VSM_ShadowResolve.hlsl).
		uint opacity_texture_index;
	}

	[Bind = DefaultLayout::Instance0]
	struct GatherPipelineGlobal
	{
		StructuredBuffer<uint> meshes_count;
		Buffer<uint> commands;

	}

	[Bind = DefaultLayout::Instance1]
	struct GatherPipeline
	{
		uint4 pip_ids[2]; # PACK TO!!!! uint4 pip_ids[2];
		AppendStructuredBuffer<CommandData> commands[8];
	}

	# Debug view culling capture (Graphics:CullCapture): every mesh this gather
	# sends to a draw gets stamps[mesh id] = stamp, (frame << 2) | stage. Only the
	# main view's GBuffer draws set it -- see mesh_renderer::capture.
	[Bind = DefaultLayout::Instance2]
	struct CullCaptureWrite
	{
		RWStructuredBuffer<uint> stamps;
		uint stamp;
	}

	struct BoxInfo
	{
		uint node_offset;
		uint mesh_id;
	}

	# Producers maintain counters manually (InterlockedAdd) instead of Append so
	# the slot index is known: it initializes visible_boxes[idx] (kills the old
	# full-buffer 999 clears) and bumps the consumer's DispatchArguments /
	# DrawIndexedArguments via InterlockedMax (kills the InitDispatch dispatches
	# and the counter->draw-args copy).
	[Bind = DefaultLayout::Instance1]
	struct GatherBoxes
	{
		RWStructuredBuffer<BoxInfo> culledMeshes;
		RWStructuredBuffer<uint> culledCount;
		RWStructuredBuffer<uint> visible_boxes;
		RWStructuredBuffer<DrawIndexedArguments> drawBoxesArgs;
		RWStructuredBuffer<DispatchArguments> gatherMeshesArgs;

		RWStructuredBuffer<uint> visibleMeshes;
		RWStructuredBuffer<uint> visibleCount;
		RWStructuredBuffer<DispatchArguments> renderArgs;
	}



	[Bind = DefaultLayout::Instance1]
	struct DrawBoxes
	{
		StructuredBuffer<float4> vertices;
		StructuredBuffer<BoxInfo> input_meshes;

		RWStructuredBuffer<uint> visible_meshes;
	}

	[Bind = DefaultLayout::Instance1]
	struct InitDispatch
	{
		RWStructuredBuffer<uint> counter;
		#RWStructuredBuffer<GatherPipelineGlobal> pipelineGlobal;
		RWStructuredBuffer<DispatchArguments> dispatch_data;
	}

	[Bind = DefaultLayout::Instance1]
	struct GatherMeshesBoxes
	{
		StructuredBuffer<BoxInfo> input_meshes;
		StructuredBuffer<uint> visible_boxes;

		RWStructuredBuffer<uint> visibleMeshes;
		RWStructuredBuffer<uint> visibleCount;
		RWStructuredBuffer<DispatchArguments> renderArgs;

		RWStructuredBuffer<uint> invisibleMeshes;
		RWStructuredBuffer<uint> invisibleCount;
		RWStructuredBuffer<DispatchArguments> retestArgs;
	}





	ComputePSO GatherPipeline
	{
		root = DefaultLayout;

		[EntryPoint = CS]
		compute = "gbuffer/gather_pipeline.hlsl";

		[rename = CHECK_FRUSTUM]
		[CS, nullable]
		define CheckFrustum;

		# Writes CullCaptureWrite for every mesh it appends.
		[rename = CAPTURE_VISIBILITY]
		[CS, nullable]
		define CaptureVisibility;

		# Hands out lod_draw_commands instead of draw_commands. Must match the
		# draws' GBufferDraw ClusterLod permutation (mesh_renderer sets both).
		[rename = CLUSTER_LOD]
		[CS, nullable]
		define ClusterLod;
	}



	ComputePSO GatherBoxes
	{
		root = DefaultLayout;

		[EntryPoint = CS_boxes]
		compute = "gbuffer/gather_pipeline.hlsl";

		[rename = CHECK_FRUSTUM]
		[CS, nullable]
		define CheckFrustum;
	}

	ComputePSO InitDispatch
	{
		root = DefaultLayout;

		[EntryPoint = CS]
		compute = "occlusion/occluder_cs_dispatch_init.hlsl";

		[rename = CHECK_FRUSTUM]
		[CS, nullable]
		define CheckFrustum;
	}


	ComputePSO GatherMeshes
	{
		root = DefaultLayout;

		[EntryPoint = CS_meshes_from_boxes]
		compute = "gbuffer/gather_pipeline.hlsl";

		[rename = INVISIBLE]
		[CS, nullable]
		define Invisible;
	}

	# Per-stage arg resets are plain clear_uav-to-zero calls (CLEAR sync differs
	# from COMPUTE, so the state tracker emits a real barrier before the producer
	# dispatches — a reset CS would be same-state UAV->UAV and race). Producers
	# restore the constant components (dispatch y/z = 1, draw IndexCount = 36)
	# with benign racing writes whenever they bump the counts.



	GraphicsPSO RenderBoxes
	{
		root = DefaultLayout;

		[EntryPoint = VS]
		vertex = "occlusion/occluder.hlsl";

		[EntryPoint = PS]
		pixel = "occlusion/occluder.hlsl";

		conservative = true;
		depth_write = false;

		ds = D32_FLOAT;

		cull = None;

		# reversed-Z: box passes if any pixel is at least as close as the farthest
		# occluder depth stored in the HiZ tile (see downsample_depth.hlsl min()).
		depth_func = GREATER_EQUAL;
	}
}
