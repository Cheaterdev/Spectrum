namespace Utility
{
	[Bind = DefaultLayout::Instance0]
	struct BlueNoise
	{
		uint frame_index;
		# Structured, not typed Buffer<uint>: on Vulkan a typed read through the
		# storage-buffer descriptor the heap holds is undefined -- WRITE_INVALID
		# device loss on NVIDIA within a few frames.
		StructuredBuffer<uint> sobol_buffer;
		StructuredBuffer<uint> ranking_tile_buffer;
		StructuredBuffer<uint> scrambling_tile_buffer;

		RWTexture2D<float2> blue_noise_texture;
	}


	ComputePSO BlueNoise
	{
		root = DefaultLayout;

		[EntryPoint = CS]
		[Enable16bits]
		compute = "postprocess/blue_noise.hlsl";
	}

	[Compute]
	[RunAlways]
	PassNode BlueNoise
	{
		[Always = UnorderedAccess] [Size = 128] [Format = R8G8_UNORM] Texture BlueNoise;
	}
}
