namespace Dev
{
	# One world-space line segment for DebugDraw (Graphics:DebugDraw). a.w is the
	# thickness in pixels, b.w is unused.
	[nobind]
	struct DebugLineSegment
	{
		float4 a;
		float4 b;
		float4 color;
	}

	[Bind = DefaultLayout::Instance0]
	struct DebugLines
	{
		StructuredBuffer<DebugLineSegment> segments;
		float2 viewport_size;
		# Multiplies every segment's alpha: 1 for the depth-tested draw, lower for
		# the x-ray draw of the occluded parts.
		float alpha_scale = 1;
	}

	# Line segments are expanded to screen-space quads in the VS (6 vertices per
	# segment, no vertex buffer) instead of LINE topology, which can't do width or
	# antialiasing.
	GraphicsPSO DebugLinesDraw
	{
		root = DefaultLayout;

		[EntryPoint = VS]
		vertex = "debug/debug_lines.hlsl";

		[EntryPoint = PS]
		pixel = "debug/debug_lines.hlsl";

		rtv = { R8G8B8A8_UNORM };
		blend = { AlphaBlend };
		ds = D32_FLOAT;
		depth_write = false;
		cull = None;
	}

	# X-ray: only the parts of the lines hidden behind geometry (reversed-Z, so
	# "behind" is LESS). Written out in full rather than `: DebugLinesDraw` --
	# prismc doesn't carry a parent PSO's root/shaders/state into a derived one.
	GraphicsPSO DebugLinesOccluded
	{
		root = DefaultLayout;

		[EntryPoint = VS]
		vertex = "debug/debug_lines.hlsl";

		[EntryPoint = PS]
		pixel = "debug/debug_lines.hlsl";

		rtv = { R8G8B8A8_UNORM };
		blend = { AlphaBlend };
		ds = D32_FLOAT;
		depth_write = false;
		depth_func = LESS;
		cull = None;
	}

	# What the debug view draws. Everything but All reads the culling capture: what
	# the main view's GBuffer drew on the captured frame (CullCaptureWrite).
	enum DebugViewSource
	{
		# Every mesh, coloured by object.
		All;
		# Every mesh, tinted by what the main view did with it.
		Status;
		# Only what the main view drew.
		Rendered;
		# Only what the main view culled: whole parts, and culled meshlets of
		# parts it drew.
		Culled;
	}

	# Every scene mesh, gathered into indirect lists by class so each list can be
	# drawn with its own DebugViewTint -- the PS can't tell which mesh it's
	# shading. The debug view draws with a single flat-shaded PSO, so there are
	# no per-material batches.
	#   commands[0]  drawn by the main view (stage 1, or the direct path); All
	#   commands[1]  drawn by the occlusion culler's stage-2 retest
	#   commands[2]  culled
	#   commands[3]  never rasterized by the main view (translucent)
	[Bind = DefaultLayout::Instance1]
	struct DebugViewGather
	{
		AppendStructuredBuffer<CommandData> commands[4];
		StructuredBuffer<uint> stamps;
		uint capture_frame;
		DebugViewSource source;
	}

	# Per-bucket state for one DebugViewMesh indirect draw.
	[Bind = DefaultLayout::Instance3]
	struct DebugViewDraw
	{
		# rgb blended over the per-object colour by a.
		float4 tint;

		# Replay of the main view's per-meshlet result (MeshletCaptureWrite):
		# nonzero for buckets whose parts the main view drew on the captured
		# frame. Other buckets have no valid masks and show every meshlet.
		StructuredBuffer<uint> meshlet_masks;
		uint read_meshlet_masks;
		# 0 every meshlet, 1 only drawn ones, 2 only culled ones.
		uint meshlet_filter;

		# Colour by object and meshlet instead of by object.
		uint color_by_meshlet;
	}

	# The captured main-camera frustum: pixels outside it are darkened, so what
	# the main view could see stands out. Same planes the culling tests.
	[Bind = DefaultLayout::Instance4]
	struct DebugViewFrustum
	{
		Frustum frustum;
		# Brightness multiplier outside the frustum; 1 turns the highlight off.
		float outside_brightness = 1;
	}

	ComputePSO DebugViewGather
	{
		root = DefaultLayout;

		[EntryPoint = CS]
		compute = "debug/debug_view_gather.hlsl";
	}

	# The GBuffer's mesh + amplification shaders with a flat headlight PS. The AS
	# frustum-culls meshlets against the debug camera bound for this draw (only to
	# save work) and replays the main view's recorded per-meshlet result
	# (DebugViewDraw) instead of culling for real, so culled meshlets still draw.
	GraphicsPSO DebugViewMesh
	{
		root = DefaultLayout;

		# gbuffer/mesh_shader.hlsl with DEBUG_VIEW defined -- see that file.
		[EntryPoint = VS]
		mesh = "debug/debug_view_mesh_shader.hlsl";

		[EntryPoint = AS]
		amplification = "debug/debug_view_mesh_shader.hlsl";

		[EntryPoint = PS]
		pixel = "debug/debug_view_mesh.hlsl";

		rtv = { R8G8B8A8_UNORM };
		ds = D32_FLOAT;
		cull = None;
	}

	# Mirrors whether the debug view window is on screen (debug_view::update_frame).
	struct DebugViewState
	{
		bool enabled = false;
	}

	# Renders the debug camera's view into the debug window's own textures, which
	# the FrameGraph doesn't track -- hence [Required]. `scene` orders it after
	# PreScene's upload of the scene buffers the draws read. The capture buffer is
	# external too, so nothing orders this after the Scene pass that writes it
	# except the pipeline listing: keep it after Scene and off the async queues.
	[Required]
	[SetupCondition = DebugViewState::enabled]
	PassNode DebugView
	{
		[Always = Read] StructuredBuffer<uint> scene;
	}
}
