namespace Meshes
{
	[Bind = DefaultLayout::MaterialData]
	struct MaterialInfo
	{
		[dynamic] MaterialCB data;
	    Texture2D<float4> textures[];
		# Two dwords per descriptor-heap index of a texture's SRV (what `textures` holds). [2 * index]: 0 for a texture
		# that is fully resident, otherwise the finest mip of a streamed one that has memory behind it, plus one. [2 * index + 1]:
		# where the texture reports what it sampled (stream_feedback.hlsl). A shader must not
		# sample finer than that: the tiles of the finer mips are not mapped and read as zero. Shared by every material
		# (TextureStreaming::Manager), so it reaches the raster and the ray tracing shaders alike.
		StructuredBuffer<uint> stream_info;
	}
}
