export module Graphics:EngineAssets;
import :Asset;
import :MeshAsset;
import :BinaryAsset;
import :FontAsset;
import :TextureAsset;

export namespace EngineAssets
{
	// The fonts of Text::Engine's roles; GraphicsSystem hands them to Text::Engine::set_font.
	extern EngineAsset<FontAsset> default_font;
	extern EngineAsset<FontAsset> mono_font;
	extern EngineAsset<FontAsset> emoji_font;
	extern EngineAsset<MeshAsset> material_tester;
	extern EngineAsset<MeshAsset> axis;
	extern EngineAsset<MeshAsset> plane;
	// Material preview shapes (resources/preview, generated by generate_preview_meshes.py).
	extern EngineAsset<MeshAsset> preview_sphere;
	extern EngineAsset<MeshAsset> preview_rounded_cube;
	extern EngineAsset<MeshAsset> preview_slab;
	extern EngineAsset<MeshAsset> preview_cloth;
	extern EngineAsset<BinaryAsset> material_header;
	extern EngineAsset<BinaryAsset> material_raytracing_header;
	extern EngineAsset<BinaryAsset> material_preview_header;
	extern EngineAsset<BinaryAsset> material_preview_3d_header;


	extern EngineAsset<TextureAsset> best_fit_normals;
	extern EngineAsset<TextureAsset> missing_texture;

}
