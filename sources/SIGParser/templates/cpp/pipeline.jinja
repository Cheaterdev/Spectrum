{% for entry in pipeline.entries %}
#include "{{entry.name}}.h"
{%- endfor %}

using namespace FrameGraph;

namespace Pipelines
{

class {{pipeline.name}}
{
public:
{% for entry in pipeline.entries %}
	Passes::{{entry.name}} {{lowerize(entry.name)}};
{%- endfor %}

	void add_passes(FrameGraph::Graph& graph)
	{
{% for entry in pipeline.entries %}
{%- set pass_def = parsed.passes[entry.name] %}
{%- if pass_def is defined and pass_def.options.Multiple is defined %}
		for (uint32_t i = 0; i < Passes::{{entry.name}}::MaxCount; ++i)
			graph.add_library_pass<Passes::{{entry.name}}>(Passes::{{entry.name}}::Names[i], {{lowerize(entry.name)}}.setup_func, {{lowerize(entry.name)}}.render_func);
{%- else %}
		graph.add_library_pass<Passes::{{entry.name}}>({{lowerize(entry.name)}}.setup_func, {{lowerize(entry.name)}}.render_func);
{%- endif %}
{%- endfor %}
	}
};

}
