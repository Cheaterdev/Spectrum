{% for entry in pipeline.entries %}
#include "{{entry.name}}.h"
{%- endfor %}
#include "../pass_defaults.h"

using namespace FrameGraph;

namespace Pipelines
{

class {{pipeline.name}}
{
public:
{% for entry in pipeline.entries %}
{%- set pass_def = parsed.passes[entry.name] %}
{%- if pass_def is defined and pass_def.options.Static is undefined %}
	Passes::{{entry.name}} {{lowerize(entry.name)}};
{%- endif %}
{%- endfor %}

	void add_passes(FrameGraph::Graph& graph)
	{
{% for entry in pipeline.entries %}
{%- set pass_def = parsed.passes[entry.name] %}
{%- if pass_def is defined %}
{%- if pass_def.options.Static is defined and pass_def.options.Multiple is defined %}
		for (uint32_t i = 0; i < Passes::{{entry.name}}::MaxCount; ++i)
			graph.add_library_pass<Passes::{{entry.name}}>(i, PassDefault<Passes::{{entry.name}}>::setup, PassDefault<Passes::{{entry.name}}>::render, PassDefault<Passes::{{entry.name}}>::flags);
{%- elif pass_def.options.Multiple is defined %}
		for (uint32_t i = 0; i < Passes::{{entry.name}}::MaxCount; ++i)
			if ({{lowerize(entry.name)}}.setup_funcs[i])
				graph.add_library_pass<Passes::{{entry.name}}>(i, {{lowerize(entry.name)}}.setup_funcs[i], {{lowerize(entry.name)}}.render_funcs[i], {{lowerize(entry.name)}}.flags);
{%- elif pass_def.options.Static is defined %}
		graph.add_library_pass<Passes::{{entry.name}}>(PassDefault<Passes::{{entry.name}}>::setup, PassDefault<Passes::{{entry.name}}>::render, PassDefault<Passes::{{entry.name}}>::flags);
{%- else %}
		if ({{lowerize(entry.name)}}.setup_func)
			graph.add_library_pass<Passes::{{entry.name}}>({{lowerize(entry.name)}}.setup_func, {{lowerize(entry.name)}}.render_func, {{lowerize(entry.name)}}.flags);
{%- endif %}
{%- endif %}
{%- endfor %}
	}
};

}
