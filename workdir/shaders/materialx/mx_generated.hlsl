// ND_line_float
float mx_line_float(float2 i_texcoord, float2 i_center, float i_radius, float2 i_point1, float2 i_point2)
{
    float2 n_delta = mx_subtract(i_texcoord, i_center);
    float2 n_p_a = mx_subtract(n_delta, i_point1);
    float2 n_b_a = mx_subtract(i_point2, i_point1);
    float n_dot_pa_ba = mx_dotproduct(n_p_a, n_b_a);
    float n_dot_ba_ba = mx_dotproduct(n_b_a, n_b_a);
    float n_divide_dots = mx_divide(n_dot_pa_ba, n_dot_ba_ba);
    float n_clamp = mx_clamp(n_divide_dots, 0.0f, 1.0f);
    float2 n_multiply_clamp_ba = mx_multiply_fa(n_b_a, n_clamp);
    float n_distance = mx_distance_float(n_p_a, n_multiply_clamp_ba);
    float n_dist_comp = mx_ifgreater(n_distance, i_radius, 0.0f, 1.0f);
    return n_dist_comp;
}

// ND_hexagon_float
float mx_hexagon_float(float2 i_texcoord, float2 i_center, float i_radius)
{
    float2 n_delta = mx_subtract(i_texcoord, i_center);
    float2 n_delta_abs = mx_absval(n_delta);
    float n_delta_abs_separate_outx;
    float n_delta_abs_separate_outy;
    mx_separate2(n_delta_abs, n_delta_abs_separate_outx, n_delta_abs_separate_outy);
    float2 n_p = mx_combine2(n_delta_abs_separate_outy, n_delta_abs_separate_outx);
    float3 n_k = mx_constant_vector3(float3(-0.866025f, 0.5f, 0.57735f));
    float n_k_separate_outx;
    float n_k_separate_outy;
    float n_k_separate_outz;
    mx_separate3(n_k, n_k_separate_outx, n_k_separate_outy, n_k_separate_outz);
    float2 n_kxy = mx_combine2(n_k_separate_outx, n_k_separate_outy);
    float n_dot_kxy_p = mx_dotproduct(n_kxy, n_p);
    float n_min_dotkxyp_p = mx_min(n_dot_kxy_p, 0.0f);
    float2 n_multiply_kxy_min = mx_multiply_fa(n_kxy, n_min_dotkxyp_p);
    float2 n_multiply2_1 = mx_multiply_fa(n_multiply_kxy_min, 2.0f);
    float2 n_new_p1 = mx_subtract(n_p, n_multiply2_1);
    float3 n_minus_k = mx_multiply_fa(n_k, -1.0f);
    float n_minus_k_separate_outx;
    float n_minus_k_separate_outy;
    float n_minus_k_separate_outz;
    mx_separate3(n_minus_k, n_minus_k_separate_outx, n_minus_k_separate_outy, n_minus_k_separate_outz);
    float2 n_combine_mkx_ky = mx_combine2(n_minus_k_separate_outx, n_k_separate_outy);
    float n_dot_kxy_p1 = mx_dotproduct(n_combine_mkx_ky, n_new_p1);
    float n_min_0 = mx_min(n_dot_kxy_p1, 0.0f);
    float2 n_multiply_min_comb = mx_multiply_fa(n_combine_mkx_ky, n_min_0);
    float2 n_multiply2_2 = mx_multiply_fa(n_multiply_min_comb, 2.0f);
    float2 n_new_p2 = mx_subtract(n_new_p1, n_multiply2_2);
    float n_new_p2_x = mx_extract_float(n_new_p2, 0);
    float n_minus_kz_r = mx_multiply(n_minus_k_separate_outz, i_radius);
    float n_kz_r1 = mx_multiply(n_k_separate_outz, i_radius);
    float n_clamp = mx_clamp(n_new_p2_x, n_minus_kz_r, n_kz_r1);
    float2 n_combine_clamp_rad = mx_combine2(n_clamp, i_radius);
    float2 n_new_p3 = mx_subtract(n_new_p2, n_combine_clamp_rad);
    float n_p3_sum = mx_dotproduct(n_new_p3, float2(1.0f, 1.0f));
    float n_p3_sqrt = mx_sqrt(n_p3_sum);
    float n_ifgreater_p3 = mx_ifgreater(n_p3_sqrt, 0.0f, 0.0f, 1.0f);
    return n_ifgreater_p3;
}

// ND_grid_color3
float3 mx_grid_color3(float2 i_texcoord, float2 i_uvtiling, float2 i_uvoffset, float i_thickness, bool i_staggered)
{
    float2 n_texcoord_scale = mx_multiply(i_texcoord, i_uvtiling);
    float2 n_texcoord_bias = mx_subtract(n_texcoord_scale, i_uvoffset);
    float n_texcoord_bias_separate_outx;
    float n_texcoord_bias_separate_outy;
    mx_separate2(n_texcoord_bias, n_texcoord_bias_separate_outx, n_texcoord_bias_separate_outy);
    float n_mod_Y_row = mx_modulo(n_texcoord_bias_separate_outy, 2.0f);
    float n_alt_rows_shift = mx_ifgreater(n_mod_Y_row, 1.0f, 0.5f, 0.0f);
    float n_shift_X = mx_add(n_texcoord_bias_separate_outx, n_alt_rows_shift);
    float n_stagger_selection = mx_ifequal(i_staggered, true, n_shift_X, n_texcoord_bias_separate_outx);
    float n_mod_X = mx_modulo(n_stagger_selection, 1.0f);
    float n_modx_2 = mx_multiply(n_mod_X, 2.0f);
    float n_subX_1 = mx_subtract(n_modx_2, 1.0f);
    float n_abs_X = mx_absval(n_subX_1);
    float n_thick_to_size = mx_subtract(1.0f, i_thickness);
    float n_X_detect = mx_ifgreater(n_abs_X, n_thick_to_size, 0.0f, 1.0f);
    float n_mod_Y = mx_modulo(n_texcoord_bias_separate_outy, 1.0f);
    float n_mody_2 = mx_multiply(n_mod_Y, 2.0f);
    float n_subY_1 = mx_subtract(n_mody_2, 1.0f);
    float n_abs_Y = mx_absval(n_subY_1);
    float n_Y_detect = mx_ifgreater(n_abs_Y, n_thick_to_size, 0.0f, 1.0f);
    float n_min = mx_min(n_X_detect, n_Y_detect);
    float n_inv_result = mx_subtract(1.0f, n_min);
    float3 n_to_rgb = mx_convert_color3(n_inv_result);
    return n_to_rgb;
}

// ND_crosshatch_color3
float3 mx_crosshatch_color3(float2 i_texcoord, float2 i_uvtiling, float2 i_uvoffset, float i_thickness, bool i_staggered)
{
    float2 n_texcoord_scale = mx_multiply(i_texcoord, i_uvtiling);
