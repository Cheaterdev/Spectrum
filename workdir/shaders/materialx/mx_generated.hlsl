}

// ND_ramp
float4 mx_ramp_color4(float2 i_texcoord, int i_type, int i_interpolation, int i_num_intervals, float i_interval1, float4 i_color1, float i_interval2, float4 i_color2, float i_interval3, float4 i_color3, float i_interval4, float4 i_color4, float i_interval5, float4 i_color5, float i_interval6, float4 i_color6, float i_interval7, float4 i_color7, float i_interval8, float4 i_color8, float i_interval9, float4 i_color9, float i_interval10, float4 i_color10)
