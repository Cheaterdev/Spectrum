// ND_overlay_float
float mx_overlay_float(float i_fg, float i_bg, float i_mix)
{
    float n_N_subtract_lower_one_bg = mx_subtract(1.0f, i_bg);
    float n_N_subtract_lower_one_fg = mx_subtract(1.0f, i_fg);
    float n_N_multiply_lower_fg_bg = mx_multiply(n_N_subtract_lower_one_bg, n_N_subtract_lower_one_fg);
    float n_N_multiply_lower_two = mx_multiply(n_N_multiply_lower_fg_bg, 2.0f);
    float n_N_subtract_lower_one = mx_subtract(1.0f, n_N_multiply_lower_two);
    float n_N_multiply_upper_fg_bg = mx_multiply(i_fg, i_bg);
    float n_N_multiply_upper_two = mx_multiply(n_N_multiply_upper_fg_bg, 2.0f);
    float n_N_ifgreatereq0_overlay_r = mx_ifgreatereq(i_bg, 0.5f, n_N_subtract_lower_one, n_N_multiply_upper_two);
    float n_N_mix = mx_mix(n_N_ifgreatereq0_overlay_r, i_bg, i_mix);
    return n_N_mix;
}

