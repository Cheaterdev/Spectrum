// ND_place2d_vector2
float2 mx_place2d_vector2(float2 i_texcoord, float2 i_pivot, float2 i_scale, float i_rotate, float2 i_offset, int i_operationorder)
{
    float2 n_N_subpivot = mx_subtract(i_texcoord, i_pivot);
    float2 n_N_applyscale = mx_divide(n_N_subpivot, i_scale);
    float2 n_N_applyrot = mx_rotate2d(n_N_applyscale, i_rotate);
    float2 n_N_applyoffset = mx_subtract(n_N_applyrot, i_offset);
    float2 n_N_addpivot = mx_add(n_N_applyoffset, i_pivot);
    float2 n_N_applyoffset2 = mx_subtract(n_N_subpivot, i_offset);
    float2 n_N_applyrot2 = mx_rotate2d(n_N_applyoffset2, i_rotate);
    float2 n_N_applyscale2 = mx_divide(n_N_applyrot2, i_scale);
    float2 n_N_addpivot2 = mx_add(n_N_applyscale2, i_pivot);
    float2 n_N_switch_operationorder = mx_switch_vector2(n_N_addpivot, n_N_addpivot2, float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), float2(0.0f, 0.0f), i_operationorder);
    return n_N_switch_operationorder;
}

