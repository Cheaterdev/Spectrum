// ND_colorcorrect_color3
float3 mx_colorcorrect_color3(float3 i_in, float i_hue, float i_saturation, float i_gamma, float i_lift, float i_gain, float i_contrast, float i_contrastpivot, float i_exposure)
{
    float3 n_N_parm2hue = mx_combine3(i_hue, 1.0f, 1.0f);
    float3 n_N_hsvadjust = mx_hsvadjust_color3(i_in, n_N_parm2hue);
    float3 n_N_saturation = mx_saturate_color3(n_N_hsvadjust, i_saturation, float3(0.2722287f, 0.6740818f, 0.0536895f));
    float3 n_N_gamma = mx_range_fa_color3(n_N_saturation, 0.0f, 1.0f, i_gamma, 0.0f, 1.0f, false);
    float n_N_liftsubtract = mx_subtract(1.0f, i_lift);
    float3 n_N_liftmult = mx_multiply_fa(n_N_gamma, n_N_liftsubtract);
    float3 n_N_liftadd = mx_add_fa(n_N_liftmult, i_lift);
    float3 n_N_gain = mx_multiply_fa(n_N_liftadd, i_gain);
    float3 n_N_contrast = mx_contrast_fa_color3(n_N_gain, i_contrast, i_contrastpivot);
    float n_N_exposurepwr = mx_power(2.0f, i_exposure);
    float3 n_N_exposure = mx_multiply_fa(n_N_contrast, n_N_exposurepwr);
    return n_N_exposure;
}

