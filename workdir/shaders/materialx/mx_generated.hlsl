    float n_N_offset_saturation = mx_add(n_N_convertSeed1, 1522.4f);
    int n_N_seed_saturation = mx_ceil(n_N_offset_saturation);
    float n_N_rand_saturation = mx_randomfloat_float(i_in, 0.0f, 1.0f, n_N_seed_saturation);
    float n_N_range_saturation = mx_range(n_N_rand_saturation, 0.0f, 1.0f, 1.0f, i_saturationlow, i_saturationhigh, false);
    float n_N_offset_brightness = mx_add(n_N_convertSeed1, 1813.8f);
    int n_N_seed_brightness = mx_ceil(n_N_offset_brightness);
    float n_N_rand_brightness = mx_randomfloat_float(i_in, 0.0f, 1.0f, n_N_seed_brightness);
    float n_N_range_brightness = mx_range(n_N_rand_brightness, 0.0f, 1.0f, 1.0f, i_brightnesslow, i_brightnesshigh, false);
    float3 n_N_combine_HSV = mx_combine3(n_N_range_hue, n_N_range_saturation, n_N_range_brightness);
