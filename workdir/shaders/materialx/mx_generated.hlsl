    float4 n_N_mixtop_vector4 = mx_mix(i_valuetr, i_valuetl, n_N_s_vector4);
    float n_N_t_vector4 = mx_extract_float(n_N_txclamp_vector4, 1);
    float4 n_N_mix_vector4 = mx_mix(n_N_mixtop_vector4, n_N_mixbot_vector4, n_N_t_vector4);
    return n_N_mix_vector4;
}

