    float2 n_circular_multiply = mx_multiply_fa(n_subtract_half, 1.414f);
    float n_circular_magnitude = mx_magnitude(n_circular_multiply);
    float2 n_box_absval = mx_absval(n_subtract_half);
    float n_separate6_outx;
    float n_separate6_outy;
    mx_separate2(n_box_absval, n_separate6_outx, n_separate6_outy);
    float2 n_box_multiply = mx_multiply_fa(n_box_absval, 2.0f);
