// ND_logical_xor
bool mx_xor_boolean(bool i_in1, bool i_in2)
{
    bool n_not_in2 = mx_not_boolean(i_in2);
    bool n_in1_and_not_in2 = mx_and_boolean(i_in1, n_not_in2);
    bool n_not_in1 = mx_not_boolean(i_in1);
    bool n_in2_and_not_in1 = mx_and_boolean(i_in2, n_not_in1);
    bool n_or = mx_or_boolean(n_in1_and_not_in2, n_in2_and_not_in1);
