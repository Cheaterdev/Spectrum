<?xml version="1.0"?>
<!-- Brushed steel: metallic, moderately rough, strongly anisotropic. The sun
     highlight and the reflections stretch perpendicular to the brushing
     direction (the mesh's tangent, rotated by specular_rotation). -->
<materialx version="1.39">
  <standard_surface name="steel_shader" type="surfaceshader">
    <input name="base_color" type="color3" value="0.75, 0.75, 0.78" />
    <input name="metalness" type="float" value="1.0" />
    <input name="specular_roughness" type="float" value="0.35" />
    <input name="specular_anisotropy" type="float" value="0.8" />
    <input name="specular_rotation" type="float" value="0.0" />
  </standard_surface>

  <surfacematerial name="brushed_steel" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="steel_shader" />
  </surfacematerial>
</materialx>
