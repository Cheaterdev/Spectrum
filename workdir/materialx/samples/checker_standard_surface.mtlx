<?xml version="1.0"?>
<!-- Checkerboard base color, rough metal stripes via noise, tinted emission.
     Exercises: standard_surface mapping, a stdlib procedural, noise, constants,
     a multiply feeding an input, and a node connection. -->
<materialx version="1.39">
  <checkerboard name="checker" type="color3">
    <input name="color1" type="color3" value="0.9, 0.2, 0.1" />
    <input name="color2" type="color3" value="0.1, 0.1, 0.12" />
    <input name="uvtiling" type="vector2" value="8, 8" />
  </checkerboard>

  <noise2d name="rough_noise" type="float">
    <input name="amplitude" type="float" value="0.25" />
    <input name="pivot" type="float" value="0.45" />
  </noise2d>

  <standard_surface name="checker_shader" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodename="checker" />
    <input name="metalness" type="float" value="0.6" />
    <input name="specular_roughness" type="float" nodename="rough_noise" />
    <input name="emission" type="float" value="0.15" />
    <input name="emission_color" type="color3" value="1.0, 0.5, 0.2" />
  </standard_surface>

  <surfacematerial name="checker_mat" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="checker_shader" />
  </surfacematerial>
</materialx>
