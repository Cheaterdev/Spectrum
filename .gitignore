#Project-specific
# Ignore local Claude Code state (settings.local.json, caches) but keep the
# shared skills, which describe repo workflows and belong in version control.
.claude/*
!.claude/skills/
log.txt
*.log
# Temporary debug logging — see "Temporary debug logging" in CLAUDE.md
*.temp

projects/

workdir/cache/
workdir/Assets/
workdir/pso
workdir/assert.txt

# Vendored NVIDIA NRD shader source (Shaders/*.hlsli, *.hlsl) + MathLib's
# ml.hlsli, recompiled locally via HAL::ShaderCompiler -- same license as
# vcpkg_installed/ (proprietary NVIDIA source, "distribution ... without an
# express license agreement from NVIDIA CORPORATION is strictly
# prohibited" per each file's own header), must never be committed. Lives
# in its own subfolder specifically so a blanket ignore here can't also eat
# our own SIG-binding shims (sig_*.hlsl, *_shim.hlsli) living alongside it in
# workdir/shaders/nrd/ -- a name-pattern-based re-include (the previous
# approach here) silently swallowed every new file that didn't happen to
# match sig_*.hlsl (found 2026-09-09: several of our own hand-written .hlsl/
# .hlsli files in that folder had never actually been tracked).
workdir/shaders/nrd/3rdparty/

*.dat

AgilitySDK/
Agility.zip

PIX/
pix.zip

#aftermath dumps
*.nv-gpudmp*

#VS-specific
*.blob.cpp
*.user
obj/
bin/
.vs/
vcpkg_installed/